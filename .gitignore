# Node
node_modules/
dist/
*.tsbuildinfo
.turbo/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/

# Models and generated audio, which are never committed
models/
weights/
# A worker's voice store, which defaults to ./voices/<engine> under wherever it was started.
**/voices/
outputs/

# Local
# What this box has: absolute venv paths and a port, which mean nothing on another machine.
rhapsode.config.json
# What the install API wrote on this box: absolute venv paths, like the config. protocol.md § 10.
rhapsode.engines.json
.env
.env.*
!.env.example
*.sock
.DS_Store

# Turbo
.turbo/

# The site's generated route and config modules, rewritten on every start and build.
.docusaurus/

# Python virtualenv for the worker SDK and its engines
python/.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# pnpm writes a project-local store when the configured store path is unreachable.
.pnpm-store/

# ContractKit's build cache.
.contractkit/
.scratch/
# The site's copies of pages written elsewhere. apps/site/scripts/docs.sync.mjs writes them on every
# start and build, from the sources its list names.
apps/site/docs/operating.md
apps/site/docs/protocol.md
apps/site/docs/develop/contributing.md
apps/site/docs/develop/worker-sdk.md
apps/site/docs/develop/conformance.md
