# The image builds from source, so nothing built or installed on the host belongs in the context.
# A host node_modules in particular holds macOS binaries that would shadow the Linux ones.
**/node_modules
**/dist
**/*.tsbuildinfo
**/.turbo
.pnpm-store
.contractkit
.scratch

**/__pycache__
**/*.py[cod]
**/.venv
**/venv
**/*.egg-info
**/build
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

models
weights
**/voices
outputs

# What this box has. The container keeps its own in the /config volume.
rhapsode.config.json
rhapsode.engines.json
.env
.env.*
**/*.sock
**/.DS_Store

.git
.claude
