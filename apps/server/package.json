{
    "name": "rhapsode",
    "version": "0.1.0",
    "private": true,
    "description": "A multi-engine speech server: one contract, many TTS models.",
    "type": "module",
    "license": "MIT",
    "bin": {
        "rhapsode": "./dist/main.js"
    },
    "files": [
        "dist/**",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup src/main.ts --format esm --sourcemap && tsc --emitDeclarationOnly --declaration",
        "build:ci": "eslint --max-warnings=0 && pnpm run build",
        "lint": "eslint --fix",
        "format": "prettier --write . --ignore-path ../../.prettierignore",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "dev": "node scripts/dev.watch.mjs"
    },
    "dependencies": {
        "@rhapsode/contract": "workspace:*",
        "@rhapsode/core": "workspace:*"
    },
    "devDependencies": {
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@swc-node/register": "^1.12.1",
        "@swc/core": "^1.16.2",
        "vitest": "^4.1.11"
    }
}
