{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // Type-check only: covers tests/ as well as src/, which the build tsconfig leaves out.
        "noEmit": true,
        "rootDir": "."
    },
    "include": ["./src/**/*", "./tests/**/*", "./vite.config.ts", "./vitest.config.ts"],
    "exclude": ["node_modules", "dist"]
}
