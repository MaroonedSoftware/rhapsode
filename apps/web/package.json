{
    "name": "@rhapsode/web",
    "version": "0.0.0",
    "description": "A web page for installing rhapsode engines. A client of the management API, and nothing the terminal client lacks.",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "eslint --fix",
        "typecheck": "tsc --noEmit -p tsconfig.tests.json",
        "format": "prettier --write . --ignore-path ../../.prettierignore",
        "test": "vitest run"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.2.8",
        "@mantine/core": "^9.6.3",
        "@mantine/hooks": "^9.6.3",
        "@mantine/notifications": "^9.6.3",
        "@maroonedsoftware/rhapsode-sdk": "workspace:*",
        "@tabler/icons-react": "^3.48.0",
        "@tanstack/react-query": "^5.104.0",
        "@tanstack/react-router": "^1.170.39",
        "luxon": "^3.7.2",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@tanstack/router-plugin": "^1.168.23",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/luxon": "^3.7.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "jsdom": "^30.1.1",
        "postcss": "^8.5.25",
        "postcss-preset-mantine": "^1.18.0",
        "postcss-simple-vars": "^7.0.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "vitest": "^5.0.2"
    }
}
