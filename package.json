{
    "name": "rhapsode",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "codegen": "contractkit && contractkit -c contractkit.openapi.json && contractkit -c contractkit.openapi.worker.json && contractkit -c contractkit.models.json && contractkit -c contractkit.client.json && contractkit -c contractkit.sdk.json && node scripts/contract.models.mjs && node scripts/openapi.document.mjs",
        "codegen:check": "node scripts/codegen.check.mjs",
        "lint": "turbo run lint",
        "format": "turbo run format",
        "format:check": "prettier --check .",
        "test": "turbo run test && pnpm run test:python",
        "test:python": "node scripts/python.mjs test",
        "typecheck": "turbo run typecheck",
        "python:sync": "node scripts/python.mjs sync",
        "changeset": "changeset",
        "release": "node scripts/release.mjs",
        "conform": "node scripts/conform.mjs",
        "wizard": "pnpm --silent --filter @rhapsode/cli wizard"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.2",
        "@contractkit/cli": "^0.11.5",
        "@contractkit/plugin-docs": "^0.4.1",
        "@contractkit/plugin-python": "^0.15.3",
        "@contractkit/plugin-typescript": "^0.38.12",
        "@contractkit/prettier-plugin": "^0.14.10",
        "@types/node": "^26.1.2",
        "eslint": "^10.8.0",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "turbo": "^2.10.8",
        "typescript": "6.0.3",
        "vitest": "^5.0.0",
        "yaml": "^2.9.1"
    },
    "packageManager": "pnpm@11.23.0",
    "engines": {
        "node": ">=22"
    }
}
