#!/bin/sh
# Sourced by the nginx image's entrypoint before it renders templates, so what this exports reaches
# default.conf.template. The server container writes the token on every boot, from its config, so
# the page follows an operator who changes it once this container restarts.

token_file="${RHAPSODE_TOKEN_FILE:-/config/management.token}"

if [ -r "$token_file" ]; then
    RHAPSODE_AUTHORIZATION="Bearer $(cat "$token_file")"
else
    RHAPSODE_AUTHORIZATION=""
    echo "rhapsode: no readable $token_file, so the page can show engines but not install them" >&2
fi
export RHAPSODE_AUTHORIZATION
