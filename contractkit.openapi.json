{
    "rootDir": ".",
    "patterns": ["contracts/rhapsode.types.ck", "contracts/rhapsode.public.ck", "contracts/rhapsode.openai.ck"],
    "plugins": {
        "@contractkit/plugin-docs": {
            "docusaurus": {
                "baseDir": "apps/site/docs/",
                "label": "API",
                "position": 3,
                "areaLabels": {
                    "public": "Native API",
                    "openai": "OpenAI shim",
                    "rhapsode": "Shared"
                }
            },
            "openapi": {
                "baseDir": "docs/",
                "output": "openapi.yaml",
                "info": {
                    "title": "Rhapsode",
                    "version": "0.0.0"
                }
            }
        }
    }
}
