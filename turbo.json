{
    "$schema": "https://turborepo.com/schema.json",
    "globalEnv": ["NODE_ENV"],
    "globalPassThroughEnv": ["TMPDIR", "RHAPSODE_FFMPEG"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "codegen": {
            "cache": false
        },
        "format": {
            "dependsOn": ["^format"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true,
            "passThroughEnv": [
                "RHAPSODE_CONFIG",
                "RHAPSODE_API_TARGET",
                "RHAPSODE_PIP_TRUSTED_HOSTS",
                "HF_TOKEN",
                "HF_HOME",
                "DEV_WATCH_DEBOUNCE_MS",
                "DEV_WATCH_KILL_AFTER_MS"
            ]
        }
    }
}
