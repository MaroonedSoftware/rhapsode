{
    "name": "@rhapsode/core",
    "version": "0.0.0",
    "description": "Routing, worker supervision and model residency. Never imports torch and holds no engine knowledge.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "license": "MIT",
    "files": [
        "dist/**",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format esm --sourcemap && tsc --emitDeclarationOnly --declaration",
        "build:ci": "eslint --max-warnings=0 && pnpm run build",
        "lint": "eslint --fix",
        "format": "prettier --write . --ignore-path ../../.prettierignore",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@rhapsode/contract": "workspace:*",
        "luxon": "^3.7.2",
        "undici": "^8.9.0",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@repo/config-eslint": "workspace:*",
        "@repo/config-typescript": "workspace:*",
        "@types/luxon": "^3.7.1",
        "vitest": "^4.1.11"
    },
    "publishConfig": {
        "access": "public"
    }
}
